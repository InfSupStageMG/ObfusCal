@using static ObfusCal.Api.Components.Pages.CalendarOwnerDetail

<section class="card source-form-wizard">

    @* ── Step progress indicator ── *@
    <div class="wizard-progress">
        <div class="wizard-progress-step @(_wizardStep == 1 ? "current" : "done")">
            <span class="step-num">1</span>
            <span class="step-label">Choose service</span>
        </div>
        <div class="wizard-progress-connector"></div>
        <div class="wizard-progress-step @(_wizardStep == 2 ? "current" : _wizardStep > 2 ? "done" : "")">
            <span class="step-num">2</span>
            <span class="step-label">Name it</span>
        </div>
        <div class="wizard-progress-connector"></div>
        <div class="wizard-progress-step @(_wizardStep == 3 ? "current" : "")">
            <span class="step-num">3</span>
            <span class="step-label">Confirm</span>
        </div>
    </div>

    @if (_wizardStep == 1)
    {
        @* ── Step 1: Choose calendar service ── *@
        <h4 class="wizard-step-heading">Which calendar service would you like to add?</h4>
        <div class="wizard-plugin-grid">
            @foreach (var p in PluginOptions)
            {
                <button type="button"
                        class="wizard-plugin-card @(SelectedOption?.Id == p.Id ? "wizard-plugin-card--selected" : "")"
                        @onclick="@(() => SelectPluginAndAdvance(p))">
                    <span class="wizard-plugin-name">@p.DisplayLabel</span>
                </button>
            }
        </div>
    }
    else if (_wizardStep == 2)
    {
        @* ── Step 2: Name the calendar ── *@
        <h4 class="wizard-step-heading">What would you like to call this calendar?</h4>
        <p class="hint-text">
            This name is just for you; pick something that helps you recognise which calendar this is.
        </p>

        <FluentTextField Value="@_localDisplayName"
                         ValueChanged="@(async val => { _localDisplayName = val; await DisplayNameChanged.InvokeAsync(val); })"
                         Immediate="true"
                         Class="app-form-control"
                         Style="width: 100%; max-width: 420px; min-width: 0;"
                         Placeholder="@(SelectedOption?.DisplayName ?? "My calendar")"/>

        <CalendarColorField InputId="source-color-input"
                            AutomaticColorHex="@AutomaticColorHex"
                            Value="@ColorHex"
                            ValueChanged="@(EventCallback.Factory.Create<string?>(this, OnColorHexChangedAsync))" />

        <div class="wizard-nav-row">
            <FluentButton Appearance="Appearance.Outline" OnClick="GoBack">← Back</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="ValidateAndGoForwardAsync">Continue →</FluentButton>
        </div>
    }
    else
    {
        @* ── Step 3: Review and confirm ── *@
        var effectiveName = string.IsNullOrWhiteSpace(_localDisplayName) ? SelectedOption?.DisplayName : _localDisplayName;
        var requiresAuthentication = SelectedOption?.RequiresAuthentication == true;
        var selectedAuthenticationAction = SelectedOption?.AuthenticationActions.FirstOrDefault(action =>
            string.Equals(action.ActionId, SelectedAuthenticationActionId, StringComparison.Ordinal));

        <h4 class="wizard-step-heading">Are you happy with these settings?</h4>
        <p class="hint-text">
            @(requiresAuthentication
                ? "Review your choices below. After you confirm, you'll continue to sign in and grant access before ObfusCal finishes connecting this calendar."
                : "Review your choices below. You can always edit or remove this calendar later.")
        </p>

        <div class="wizard-summary">
            <div class="wizard-summary-row">
                <span class="wizard-summary-label">Calendar service</span>
                <span class="wizard-summary-value">@SelectedOption?.DisplayLabel</span>
            </div>
            <div class="wizard-summary-row">
                <span class="wizard-summary-label">Name</span>
                <span class="wizard-summary-value">@effectiveName</span>
            </div>
            @if (SelectedOption?.RequiresAuthenticationChoice == true)
            {
                <div class="wizard-summary-row">
                    <span class="wizard-summary-label">Access level</span>
                    <span class="wizard-summary-value">@(selectedAuthenticationAction?.Label ?? "Choose an access level below")</span>
                </div>
            }
        </div>

        @if (SelectedOption?.RequiresAuthenticationChoice == true)
        {
            <div class="wizard-auth-choice-section">
                <h5 class="section-heading">How should ObfusCal connect to this calendar?</h5>
                <p class="hint-text">
                    Choose read-only if ObfusCal should only import events. Choose write-back if ObfusCal may also
                    maintain ObfusCal-managed placeholder events in this calendar.
                </p>
                <div class="wizard-plugin-grid">
                    @foreach (var action in SelectedOption.AuthenticationActions)
                    {
                        var capturedAction = action;
                        var isSelected = string.Equals(SelectedAuthenticationActionId, action.ActionId, StringComparison.Ordinal);
                        <button type="button"
                                class="wizard-plugin-card @(isSelected ? "wizard-plugin-card--selected" : "")"
                                @onclick="@(() => SelectAuthenticationActionAsync(capturedAction.ActionId))">
                            <span class="wizard-plugin-name">@action.Label</span>
                            @if (!string.IsNullOrWhiteSpace(action.Hint))
                            {
                                <span class="hint-text">@action.Hint</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }

        <details class="wizard-advanced" @attributes="_advancedOpenAttr">
            <summary class="wizard-advanced-summary">
                Advanced settings
                <span class="wizard-advanced-subtext"> - only change these if you know what you're doing</span>
            </summary>
            <div class="wizard-advanced-body">
                @if (!string.IsNullOrWhiteSpace(SelectedOption?.SetupHint))
                {
                    <FluentMessageBar Intent="MessageIntent.Info" Class="card-message wizard-hint-bar">
                        @((MarkupString)SelectedOption.SetupHint)
                    </FluentMessageBar>
                }

                <p class="hint-text wizard-advanced-intro">
                    The fields below are pre-filled with sensible defaults that work for most people.
                    You do not need to change anything here to get started.
                </p>

                @if (HasFieldEditors(ConfigurationFields))
                {
                    @foreach (var field in ConfigurationFields.Select(f => f))
                    {
                        <div @key="field.Key" class="config-field">
                            <div class="field-label-row">
                                <label>@field.Label</label>
                                @if (!string.IsNullOrWhiteSpace(field.Description))
                                {
                                    <span class="field-info-icon" data-tooltip="@field.Description">i</span>
                                }
                            </div>
                            <input type="text"
                                   @key="@($"cfg-new-{field.Key}")"
                                   class="form-input"
                                   placeholder="@(field.Placeholder ?? "")"
                                   value="@field.Value"
                                   @oninput="@(e => field.Value = e.Value?.ToString())"/>
                        </div>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(ConfigurationJson))
                {
                    <FluentLabel Class="app-form-label">Configuration JSON</FluentLabel>
                    <textarea class="config-textarea app-form-control" @bind="ConfigurationJson"></textarea>
                }

                @if (HasFieldEditors(SecretFields))
                {
                    <p class="hint-text wizard-secret-hint">
                        🔒 These values are stored encrypted and will not be shown again after saving.
                    </p>
                    @foreach (var field in SecretFields.Select(f => f))
                    {
                        <div @key="field.Key" class="secret-field">
                            <div class="field-label-row">
                                <label>@field.Label</label>
                                @if (!string.IsNullOrWhiteSpace(field.Description))
                                {
                                    <span class="field-info-icon" data-tooltip="@field.Description">i</span>
                                }
                            </div>
                            <input type="password"
                                   @key="@($"sec-new-{field.Key}")"
                                   class="form-input"
                                   placeholder="Enter value"
                                   @oninput="@(e => field.Value = e.Value?.ToString())"/>
                        </div>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(SecretJson))
                {
                    <FluentLabel Class="app-form-label">Secret JSON</FluentLabel>
                    <textarea class="secret-textarea app-form-control" @bind="SecretJson"></textarea>
                }

                <FluentCheckbox Value="IsEnabled"
                                ValueChanged="@(async val => { IsEnabled = val; await IsEnabledChanged.InvokeAsync(val); })"
                                Label="Enable this calendar source"
                                Style="margin-top: 0.5rem;"/>
            </div>
        </details>

        @if (_stepValidationMessage is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Warning" Class="card-message">@_stepValidationMessage</FluentMessageBar>
        }

        @if (Message is not null)
        {
            <FluentMessageBar Intent="@MessageIntent" Class="card-message">@Message</FluentMessageBar>
        }

        <div class="wizard-nav-row">
            <FluentButton Appearance="Appearance.Outline" OnClick="GoBack" Disabled="IsLoading">← Back</FluentButton>
            <FluentButton Appearance="Appearance.Accent"
                          OnClick="ValidateAndSubmitAsync"
                          Disabled="@(SelectedOption is null || IsLoading)">
                @(IsLoading ? (requiresAuthentication ? "Opening sign-in…" : "Adding…") : GetSubmitButtonText())
            </FluentButton>
        </div>
    }

</section>

@code {
    [Parameter, EditorRequired]
    public List<PluginOption> PluginOptions { get; set; } = default!;

    [Parameter]
    public PluginOption? SelectedOption { get; set; }

    [Parameter]
    public EventCallback<PluginOption?> SelectedOptionChanged { get; set; }

    [Parameter]
    public string? DisplayName { get; set; }

    [Parameter]
    public EventCallback<string?> DisplayNameChanged { get; set; }

    [Parameter]
    public string? ColorHex { get; set; }

    [Parameter]
    public EventCallback<string?> ColorHexChanged { get; set; }

    [Parameter]
    public string? SelectedAuthenticationActionId { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedAuthenticationActionIdChanged { get; set; }

    [Parameter]
    public string? AutomaticColorHex { get; set; }

    [Parameter]
    public List<PluginFieldEditor> ConfigurationFields { get; set; } = [];

    [Parameter]
    public EventCallback<List<PluginFieldEditor>> ConfigurationFieldsChanged { get; set; }

    [Parameter]
    public string? ConfigurationJson { get; set; }

    [Parameter]
    public EventCallback<string?> ConfigurationJsonChanged { get; set; }

    [Parameter]
    public List<PluginFieldEditor> SecretFields { get; set; } = [];

    [Parameter]
    public EventCallback<List<PluginFieldEditor>> SecretFieldsChanged { get; set; }

    [Parameter]
    public string? SecretJson { get; set; }

    [Parameter]
    public EventCallback<string?> SecretJsonChanged { get; set; }

    [Parameter]
    public bool IsEnabled { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsEnabledChanged { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public MessageIntent MessageIntent { get; set; } = MessageIntent.Info;

    [Parameter, EditorRequired]
    public EventCallback OnAddAsync { get; set; }

    private int _wizardStep = 1;

    private string? _localDisplayName;
    private string? _lastSeenDisplayName;
    private string? _stepValidationMessage;

    // Controls whether the Advanced settings section is pre-expanded.
    private IReadOnlyDictionary<string, object> _advancedOpenAttr = new Dictionary<string, object>();

    protected override void OnParametersSet()
    {
        if (string.Equals(_lastSeenDisplayName, DisplayName, StringComparison.Ordinal)) return;
        _localDisplayName = DisplayName;
        _lastSeenDisplayName = DisplayName;
    }

    private static bool HasFieldEditors(IReadOnlyCollection<PluginFieldEditor> fields) => fields.Count > 0;

    internal Task OnColorHexChangedAsync(string? value)
    {
        ColorHex = value;
        return ColorHexChanged.InvokeAsync(value);
    }

    private async Task SelectPluginAndAdvance(PluginOption option)
    {
        SelectedOption = option;
        await SelectedOptionChanged.InvokeAsync(option);
        var defaultAuthenticationActionId = option.DefaultAuthenticationActionId;
        SelectedAuthenticationActionId = defaultAuthenticationActionId;
        await SelectedAuthenticationActionIdChanged.InvokeAsync(defaultAuthenticationActionId);
        _localDisplayName = option.DisplayName;
        _lastSeenDisplayName = _localDisplayName;
        await DisplayNameChanged.InvokeAsync(_localDisplayName);
        _wizardStep = 2;
    }

    private void GoBack()
    {
        if (_wizardStep <= 1) return;
        _stepValidationMessage = null;
        _wizardStep--;
    }

    private async Task ValidateAndGoForwardAsync()
    {
        if (_wizardStep < 3)
        {
            if (_wizardStep == 2 && string.IsNullOrWhiteSpace(GetEffectiveDisplayName()))
            {
                _stepValidationMessage = "Please enter a calendar name before continuing.";
                return;
            }

            _stepValidationMessage = null;
            _wizardStep++;

            await DisplayNameChanged.InvokeAsync(GetEffectiveDisplayName());

            _advancedOpenAttr = _wizardStep == 3 && HasRequiredMissingFields()
                ? new Dictionary<string, object> { { "open", string.Empty } }
                : new Dictionary<string, object>();
        }
    }

    private async Task ValidateAndSubmitAsync()
    {
        _stepValidationMessage = null;

        var missing = GetMissingRequiredFieldLabels();
        if (missing.Count > 0)
        {
            _advancedOpenAttr = new Dictionary<string, object> { { "open", string.Empty } };
            _stepValidationMessage = $"Please fill in the following required fields: {string.Join(", ", missing)}.";
            return;
        }

        if (SelectedOption?.RequiresAuthenticationChoice == true
            && string.IsNullOrWhiteSpace(SelectedAuthenticationActionId))
        {
            _stepValidationMessage = "Please choose whether this calendar should connect with read-only or write-back access.";
            return;
        }

        await OnAddAsync.InvokeAsync();
    }

    private string? GetEffectiveDisplayName()
        => string.IsNullOrWhiteSpace(_localDisplayName)
            ? SelectedOption?.DisplayName
            : _localDisplayName.Trim();

    private string GetSubmitButtonText()
    {
        if (SelectedOption?.RequiresAuthentication != true)
            return "✓ Add Calendar";

        var selectedAuthenticationAction = SelectedOption.AuthenticationActions.FirstOrDefault(action =>
            string.Equals(action.ActionId, SelectedAuthenticationActionId, StringComparison.Ordinal));

        return selectedAuthenticationAction?.Label ?? "Continue to sign-in";
    }

    private async Task SelectAuthenticationActionAsync(string actionId)
    {
        SelectedAuthenticationActionId = actionId;
        _stepValidationMessage = null;
        await SelectedAuthenticationActionIdChanged.InvokeAsync(actionId);
    }

    private static bool IsRequiredConfigField(PluginFieldEditor field)
        => !IsLikelyDefaultValue(field.Placeholder) && string.IsNullOrWhiteSpace(field.Value);

    private static bool IsRequiredSecretField(PluginFieldEditor field)
        => string.IsNullOrWhiteSpace(field.Value);

    private bool HasRequiredMissingFields()
        => ConfigurationFields.Any(IsRequiredConfigField)
           || (HasFieldEditors(SecretFields) && SecretFields.Any(IsRequiredSecretField));

    private List<string> GetMissingRequiredFieldLabels()
    {
        var labels = new List<string>();

        if (HasFieldEditors(ConfigurationFields))
            labels.AddRange(ConfigurationFields.Where(IsRequiredConfigField).Select(f => f.Label));

        if (HasFieldEditors(SecretFields))
            labels.AddRange(SecretFields.Where(IsRequiredSecretField).Select(f => f.Label));

        return labels;
    }
}
