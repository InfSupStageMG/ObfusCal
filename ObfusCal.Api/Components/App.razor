<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <noscript>
        <style>
            body {
                visibility: visible !important;
            }
        </style>
    </noscript>
    <script>
        window._cssLoaded = 0;
        window._cssNeeded = 4;
        window._cssTimer = null;

        function checkCssReady() {
            if (window._cssLoaded >= window._cssNeeded) {
                if (window._cssTimer) {
                    clearTimeout(window._cssTimer);
                }
                if (document.body) {
                    document.body.style.visibility = "visible";
                }
            }
        }

        function onCssLoaded() {
            window._cssLoaded += 1;
            checkCssReady();
        }

        window._cssTimer = setTimeout(function () {
            if (document.body) {
                document.body.style.visibility = "visible";
            }
        }, 2000);
    </script>
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" onload="onCssLoaded()" />
    <link rel="stylesheet" href="ObfusCal.Api.styles.css" onload="onCssLoaded()" />
    <link rel="stylesheet" href="css/app.css" onload="onCssLoaded()" />
    <link rel="stylesheet" href="css/site.css" onload="onCssLoaded()" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <title>ObfusCal</title>
</head>

<body style="visibility: hidden;">
    <CascadingAuthenticationState>
        <Routes @rendermode="RenderMode.InteractiveServer" />
    </CascadingAuthenticationState>
    <script src="js/timezone.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
