@page "/"
@attribute [Authorize]
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using ObfusCal.Application.Interfaces
@using ObfusCal.Application.Configuration
@using ObfusCal.Application.UseCases.GetMergedFreeBusy
@inject IGetMergedFreeBusyUseCase GetMergedFreeBusyUseCase
@inject ICalendarOwnerService CalendarOwnerService
@inject ICalendarOwnerAvailabilitySyncService AvailabilitySyncService
@inject CurrentUserContextAccessor CurrentUserContextAccessor
@inject IOptions<SyncOptions> SyncOptions
@inject IJSRuntime Js

<PageTitle>Dashboard - ObfusCal</PageTitle>

<header class="page-header">
    <h1>Dashboard</h1>
    <p class="page-subtitle">
        @if (_isSysadmin)
        {
            <span>View calendar owners' availability at a glance.</span>
        }
        else
        {
            <span>View your calendar at a glance and keep your availability data up to date.</span>
        }
    </p>
</header>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    @if (_accessMessage is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Warning" Title="Calendar owner access required">
            @_accessMessage
        </FluentMessageBar>
    }

    <section class="card combined-calendar-card">
        <div class="combined-calendar-card-header">
            <div>
                <h3 class="section-title">Combined Calendar</h3>
                <p class="section-subtitle">See when the selected person is busy over the coming days.</p>
            </div>
            <button type="button"
                    class="calendar-refresh-button"
                    title="Refresh calendar"
                    aria-label="Refresh calendar"
                    @onclick="RefreshAndLoadAsync"
                    disabled="@(_selectedOwner is null || _loading || _refreshing)">
                @if (_refreshing)
                {
                    <span class="calendar-refresh-button-icon calendar-refresh-button-icon--spinning">↻</span>
                }
                else
                {
                    <span class="calendar-refresh-button-icon">↻</span>
                }
            </button>
        </div>

        <div class="combined-calendar-controls" role="group" aria-label="Combined calendar filters">
            <div class="combined-calendar-field combined-calendar-field--owner app-form-field">
                <FluentLabel Class="combined-calendar-label app-form-label">Account</FluentLabel>
                <SearchableSelect TOption="CalendarOwnerOption"
                                  Items="@(_calendarOwners ?? [])"
                                  OptionText="@(o => o.Name)"
                                  OptionValue="@(o => o.Id.ToString())"
                                  Readonly="@(!_isSysadmin)"
                                  Placeholder="No mapped calendar owner"
                                  EmptyMessage="No owners found"
                                  @bind-SelectedOption="_selectedOwner"
                                  @bind-SelectedOption:after="OnOwnerChangedAsync" />
            </div>

            <div class="combined-calendar-field combined-calendar-field--timezone app-form-field">
                <FluentLabel Class="combined-calendar-label app-form-label">Time zone</FluentLabel>
                <SearchableSelect TOption="TimeZoneOption"
                                  Items="_timeZones"
                                  OptionText="@(tz => tz.DisplayName)"
                                  OptionValue="@(tz => tz.Id)"
                                  Placeholder="Select time zone…"
                                  EmptyMessage="No time zones found"
                                  @bind-SelectedOption="_selectedTimeZone"
                                  @bind-SelectedOption:after="OnTimeZoneChangedAsync" />
            </div>
        </div>

        @if (_loading)
        {
            <FluentProgress />
        }
        else if (_selectedOwner is null)
        {
            <div class="empty-state">
                <span class="empty-state-icon">📅</span>
                <p class="empty-state-title">Choose a calendar owner</p>
                <p class="empty-state-description">Select a calendar owner above to view their availability.</p>
            </div>
        }
        else if (_loadErrorMessage is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error" Title="Could not load calendar">
                @_loadErrorMessage
            </FluentMessageBar>
        }
        else if (_slots is { Count: > 0 })
        {
            <div class="combined-calendar-view-shell">
                <MergedFreeBusyCalendarView
                    Slots="_slots"
                    TimeZone="ResolveSelectedTimeZone()"
                    DisplayDate="_displayDate" />
            </div>
        }
        else if (_loaded)
        {
            <div class="empty-state">
                <span class="empty-state-icon">📅</span>
                <p class="empty-state-title">No busy slots found</p>
                <p class="empty-state-description">There are no busy slots for the selected period. Use the refresh button if you just synced new data.</p>
            </div>
        }
    </section>
</FluentStack>

@code {
    private List<CalendarOwnerOption>? _calendarOwners;
    private CalendarOwnerOption? _selectedOwner;
    private List<MergedFreeBusyResponse>? _slots;
    private DateTime _displayDate = DateTime.UtcNow.Date;
    private bool _loading;
    private bool _loaded;
    private bool _refreshing;
    private bool _isSysadmin;
    private string? _accessMessage;
    private string? _loadErrorMessage;
    private bool _autoLoadTriggered;
    private bool _selectionChangeHandlingEnabled;

    private List<TimeZoneOption> _timeZones = [];
    private TimeZoneOption? _selectedTimeZone;
    private static string? _sCachedTimeZoneId;


    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        var currentUser = await CurrentUserContextAccessor.GetCurrentAsync();
        _isSysadmin = currentUser.IsSysadmin;

        if (_isSysadmin)
        {
            var owners = await CalendarOwnerService.ListAsync();
            _calendarOwners = owners.Select(o => new CalendarOwnerOption(o.Id, o.Name)).ToList();
        }
        else
        {
            if (string.IsNullOrWhiteSpace(currentUser.EntraObjectId))
            {
                _calendarOwners = [];
                _accessMessage = "Your signed-in session did not contain an Entra object ID.";
            }
            else if (currentUser.CalendarOwnerId is null || string.IsNullOrWhiteSpace(currentUser.CalendarOwnerName))
            {
                _calendarOwners = [];
                _accessMessage = "A calendar owner could not be provisioned for your signed-in account.";
            }
            else
            {
                _calendarOwners = [new CalendarOwnerOption(currentUser.CalendarOwnerId.Value, currentUser.CalendarOwnerName)];
            }
        }

        if (_calendarOwners.Count > 0)
            _selectedOwner = _calendarOwners[0];

        _timeZones = TimeZoneInfo.GetSystemTimeZones()
            .Select(tz => new TimeZoneOption(tz.Id, tz.DisplayName))
            .OrderBy(tz => tz.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _selectedTimeZone = _timeZones.FirstOrDefault(tz =>
                                tz.Id.Equals(_sCachedTimeZoneId, StringComparison.OrdinalIgnoreCase))
                            // Romance Standard Time = Brussels/Paris/Madrid on Windows; Europe/Brussels on Linux/IANA
                            ?? _timeZones.FirstOrDefault(tz => tz.Id.Equals("Romance Standard Time", StringComparison.OrdinalIgnoreCase))
                            ?? _timeZones.FirstOrDefault(tz => tz.Id.Equals("Europe/Brussels", StringComparison.OrdinalIgnoreCase))
                            ?? _timeZones.FirstOrDefault(tz => tz.Id.Equals("Europe/Paris", StringComparison.OrdinalIgnoreCase))
                            ?? _timeZones.FirstOrDefault(tz => tz.Id.Equals("UTC", StringComparison.OrdinalIgnoreCase))
                            ?? _timeZones.FirstOrDefault();

        // Never leave the page in a loading state while waiting for render lifecycle callbacks.
        _loading = false;
        _selectionChangeHandlingEnabled = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _autoLoadTriggered)
            return Task.CompletedTask;

        _autoLoadTriggered = true;
        _ = AutoLoadCalendarAsync();
        return Task.CompletedTask;
    }

    private async Task AutoLoadCalendarAsync()
    {
        await ResolveBrowserTimeZoneAsync();

        if (_selectedOwner is not null)
            await LoadFreeBusyAsync();
        else
            await InvokeAsync(StateHasChanged);
    }

    private async Task OnOwnerChangedAsync()
    {
        if (!_selectionChangeHandlingEnabled || !_autoLoadTriggered || _loading || _refreshing)
            return;

        if (_selectedOwner is null)
        {
            _slots = null;
            _loaded = true;
            _loadErrorMessage = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await LoadFreeBusyAsync();
    }

    private async Task OnTimeZoneChangedAsync()
    {
        if (!_selectionChangeHandlingEnabled || !_autoLoadTriggered || _loading || _refreshing)
            return;

        await LoadFreeBusyAsync();
    }

    private async Task ResolveBrowserTimeZoneAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromMilliseconds(750));
            var browserTimeZone = await Js.InvokeAsync<string?>(
                "obfusCalTime.getCachedOrBrowserTimeZone",
                cts.Token);
            if (string.IsNullOrWhiteSpace(browserTimeZone))
                return;

            _sCachedTimeZoneId = browserTimeZone;

            var option = _timeZones.FirstOrDefault(tz => tz.Id.Equals(browserTimeZone, StringComparison.OrdinalIgnoreCase));
            if (option is null || Equals(option, _selectedTimeZone))
                return;

            _selectedTimeZone = option;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Never block UI if JS timezone detection stalls.
        }
        catch (JSException)
        {
            // Keep UTC when browser timezone detection is unavailable.
        }
        catch (InvalidOperationException)
        {
            // JS interop can be unavailable during early render phases.
        }
    }

    private async Task LoadFreeBusyAsync()
    {
        if (_selectedOwner is null)
            return;

        _loading = true;
        _loaded = false;
        _slots = null;
        _loadErrorMessage = null;

        try
        {
            var timeZone = ResolveSelectedTimeZone();
            _displayDate = GetCurrentDateInTimeZone(timeZone);

            // Load the full sync window so month navigation works without extra round-trips.
            // Stay within MaxQueryWindowDays to satisfy the use-case validation.
            var windowDays = Math.Min(SyncOptions.Value.LookAheadDays, SyncOptions.Value.MaxQueryWindowDays);
            var from = ConvertLocalDateBoundaryToUtc(_displayDate, timeZone);
            var to = ConvertLocalDateBoundaryToUtc(_displayDate.AddDays(windowDays), timeZone);

            var result = await GetMergedFreeBusyUseCase.ExecuteAsync(
                new GetMergedFreeBusyQuery(_selectedOwner.Id, from, to),
                CancellationToken.None);
            _slots = result.ToList();
        }
        catch (ArgumentException ex)
        {
            _slots = [];
            _loadErrorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _slots = [];
            _loadErrorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
            _loaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshAndLoadAsync()
    {
        if (_selectedOwner is null)
            return;

        _refreshing = true;
        try
        {
            await AvailabilitySyncService.RunSyncForOwnerAsync(_selectedOwner.Id, CancellationToken.None);
            await LoadFreeBusyAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private TimeZoneInfo ResolveSelectedTimeZone()
    {
        if (_selectedTimeZone is null)
            return TimeZoneInfo.Utc;

        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(_selectedTimeZone.Id);
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.Utc;
        }
        catch (InvalidTimeZoneException)
        {
            return TimeZoneInfo.Utc;
        }
    }

    private static DateTimeOffset ConvertLocalDateBoundaryToUtc(DateTime localDate, TimeZoneInfo timeZone)
    {
        var local = DateTime.SpecifyKind(localDate, DateTimeKind.Unspecified);
        var utc = TimeZoneInfo.ConvertTimeToUtc(local, timeZone);
        return new DateTimeOffset(utc, TimeSpan.Zero);
    }

    private static DateTime GetCurrentDateInTimeZone(TimeZoneInfo timeZone)
        => TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, timeZone).Date;


    private sealed record CalendarOwnerOption(Guid Id, string Name);
    private sealed record TimeZoneOption(string Id, string DisplayName);
}
