@page "/calendar-owners/{Id:guid}"
@attribute [Authorize]

<PageTitle>Calendar Owner - ObfusCal</PageTitle>

@if (_accessDeniedMessage is not null)
{
    <header class="page-header">
        <h1>Calendar Owner</h1>
    </header>
    <FluentMessageBar Intent="MessageIntent.Error" Title="Access denied">
        @_accessDeniedMessage
    </FluentMessageBar>
}
else if (_owner is null)
{
    <header class="page-header">
        <h1>Calendar Owner</h1>
    </header>
    <FluentProgress/>
}
else
{
    <header class="page-header">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => Navigation.NavigateTo(BackLink))">
                ← Back
            </FluentButton>
            <h1 class="header-title-flex">@_owner.Name</h1>
        </FluentStack>
        <p class="page-subtitle">
            Connect your calendars, manage privacy settings, and control how your availability is shared with peers.
        </p>
    </header>

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="24">

        @* ── CALENDAR SOURCES ─────────────────────────────── *@
        <section class="card">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" Class="section-header-box">
                <h3 class="header-title-flex section-title">Your Calendars</h3>
                @if (_pluginOptions.Count > 0)
                {
                    <FluentButton Appearance="@(_showAddForm ? Appearance.Outline : Appearance.Accent)"
                                  OnClick="@(() => { _showAddForm = !_showAddForm; _sourceMessage = null; _expandedSourceInstanceId = null; })">
                        @(_showAddForm ? "Cancel" : "+ Add Calendar")
                    </FluentButton>
                }
            </FluentStack>
            <p class="hint-text">
                Connect your calendar accounts here. ObfusCal will read and obfuscate the events in these calendars.
            </p>
            @if (_sourceInstances.Count > 0)
            {
                <p class="hint-text source-selection-hint">Select a calendar tile to review or edit its settings.</p>
            }

            @if (_pluginOptions.Count == 0)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" Class="card-message">
                    No calendar service plugins were found. Please contact your administrator.
                </FluentMessageBar>
            }

            @if (_showAddForm)
            {
                <SourceAddForm PluginOptions="_pluginOptions"
                               @bind-SelectedOption="SelectedPluginOption"
                               @bind-DisplayName="_newSourceDisplayName"
                               @bind-ColorHex="_newSourceColorHex"
                               AutomaticColorHex="@NewSourceAutomaticColorHex"
                               @bind-ConfigurationFields="_newSourceConfigurationFields"
                               @bind-ConfigurationJson="_newSourceConfigurationJson"
                               @bind-SecretFields="_newSourceSecretFields"
                               @bind-SecretJson="_newSourceSecretDataJson"
                               @bind-IsEnabled="_newSourceIsEnabled"
                               IsLoading="_creatingSourceInstance"
                               Message="@(_sourceMessage is not null && _lastActionInstanceId is null ? _sourceMessage : null)"
                               MessageIntent="_sourceMessageIntent"
                               OnAddAsync="CreateSourceInstanceAsync"/>
            }

            @* Success message after add (form is now closed) *@
            @if (_sourceMessage is not null && _lastActionInstanceId is null && !_showAddForm && _expandedSourceInstanceId is null)
            {
                <FluentMessageBar Intent="@_sourceMessageIntent" Class="card-message">@_sourceMessage</FluentMessageBar>
            }

            @if (_sourceInstances.Count > 0)
            {
                @if (_showAddForm)
                {
                    <hr class="section-divider source-tiles-divider"/>
                }
                <div class="source-tiles-grid">
                    @foreach (var instance in _sourceInstances)
                    {
                        var isSelected = _expandedSourceInstanceId == instance.Id;
                        <button type="button"
                                class="source-tile @(isSelected ? "source-tile--active" : "")"
                                aria-expanded="@isSelected"
                                aria-controls="source-editor-panel"
                                @onclick="@(() => { if (isSelected) { _expandedSourceInstanceId = null; } else { _expandedSourceInstanceId = instance.Id; _sourceMessage = null; } })">
                            <span class="source-tile-color"
                                  style="background-color: @CalendarColorFieldDisplay.ResolvePreviewColor(instance.ColorHex, instance.AutomaticColorHex);"
                                  aria-hidden="true"></span>
                            <span class="source-tile-name">@instance.DisplayName</span>
                            <span class="source-tile-plugin">@instance.PluginDisplayName</span>
                            <span class="source-tile-status @(instance.IsReady ? "source-tile-status--ready" : "source-tile-status--pending")">
                                @(instance.IsReady ? "● Ready" : "● Not ready")
                            </span>
                        </button>
                    }
                </div>
            }
            else if (!_showAddForm)
            {
                <div class="empty-state">
                    <span class="empty-state-icon">🔗</span>
                    <p class="empty-state-title">No calendars connected yet</p>
                    <p class="empty-state-description">
                        Click <strong>+ Add Calendar</strong> to connect your first calendar.
                    </p>
                </div>
            }
        </section>

        @* ── INLINE SOURCE EDITOR ─────────────────────────── *@
        @if (_expandedSourceInstanceId is not null)
        {
            var editInst = _sourceInstances.FirstOrDefault(x => x.Id == _expandedSourceInstanceId);
            @if (editInst is not null)
            {
                <div id="source-editor-panel" class="source-editor-panel">
                    <div class="source-editor-panel-header">
                        <h3 class="source-editor-panel-title">Editing @editInst.DisplayName</h3>
                        <p class="source-editor-panel-hint">Update calendar settings, credentials, and color preferences below.</p>
                    </div>
                    <SourceInstanceEditor Instance="editInst"
                                          IsCard="true"
                                          IsSaving="_updatingSourceInstanceId == editInst.Id"
                                          IsDeleting="_deletingSourceInstanceId == editInst.Id"
                                          IsExecutingAction="_executingActionInstanceId == editInst.Id"
                                          ExecutingActionId="_executingActionId"
                                          Message="@(_sourceMessage is not null && _lastActionInstanceId == editInst.Id ? _sourceMessage : null)"
                                          MessageIntent="_sourceMessageIntent"
                                          OnSaveAsync="@(() => UpdateSourceInstanceAsync(editInst))"
                                          OnDeleteAsync="@(() => DeleteSourceInstanceAsync(editInst.Id))"
                                          OnActionAsync="@(action => InvokePluginActionAsync(editInst, action))"
                                          OnClose="@(() => _expandedSourceInstanceId = null)"/>
                </div>
            }
        }

        @* ── PRIVACY PROFILES ─────────────────────────────── *@
        <details class="profiles-collapsible">
            <summary class="profiles-summary">
                <div class="profiles-summary-content">
                    <h3 class="profiles-summary-title">Privacy Profiles</h3>
                    <p class="profiles-summary-hint">
                        Control how much detail you and peers can see when they look at your availability.
                    </p>
                </div>
            </summary>
            <div class="profiles-inner">
                <div class="profiles-list">
                    @foreach (var profile in _profiles)
                    {
                        <div class="profile-item">
                            <ProfileCard @key="profile.Context"
                                         Profile="profile"
                                         SaveMessage="@(_profileSavedContext == profile.Context ? _profileMessage : null)"
                                         OnSaveAsync="@(() => SaveProfileAsync(profile))"/>
                        </div>
                    }
                </div>
            </div>
        </details>

        @* ── ADVANCED (collapsed by default) ─────────────── *@
        <details class="page-advanced-section">
            <summary class="page-advanced-summary">⚙ Advanced settings</summary>
            <div class="page-advanced-inner">

                <section class="card">
                    <h3 class="section-title">Availability Sync</h3>
                    <p class="hint-text">
                        Manually trigger a sync to refresh your availability snapshot right now.
                        Under normal circumstances this happens automatically in the background.
                    </p>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                                 VerticalAlignment="VerticalAlignment.Center">
                        <FluentButton Appearance="Appearance.Outline" OnClick="TriggerOwnerSyncAsync"
                                      Disabled="_triggeringSyncForOwner">
                            @(_triggeringSyncForOwner ? "Syncing…" : "Trigger Sync Now")
                        </FluentButton>
                    </FluentStack>
                    @if (_triggeringSyncForOwner)
                    {
                        <div class="sync-progress-container">
                            <FluentProgress/>
                            @if (_ownerSyncProgress is not null)
                            {
                                <p class="sync-progress-label">@_ownerSyncProgress.Message</p>
                            }
                        </div>
                    }
                    @if (_ownerSyncMessage is not null)
                    {
                        <FluentMessageBar Intent="@_ownerSyncMessageIntent" Class="card-message">
                            @_ownerSyncMessage
                        </FluentMessageBar>
                    }

                    @if (_owner.HasGraphConsent || _hasWriteBackCapableSource)
                    {
                        <hr class="section-divider"/>
                        <h4>Calendar Write-Back</h4>
                        <p class="hint-text">
                            When enabled, ObfusCal writes placeholder events back into your linked calendar
                            to block out time that your peers have marked as busy.
                            Only start and end times are written — no names, attendees, or event details.
                        </p>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                            <FluentSwitch @bind-Value="_writeBackEnabled" Label="Enable write-back to calendar"/>
                            @if (_writeBackEnabled)
                            {
                                <FluentTextField @bind-Value="_writeBackPlaceholderTitle"
                                                 Label="Placeholder event title"
                                                 Placeholder="Busy"
                                                 style="max-width:320px"/>
                            }
                            <div>
                                <FluentButton Appearance="Appearance.Outline"
                                              OnClick="SaveWriteBackSettingsAsync"
                                              Disabled="_savingWriteBack">
                                    @(_savingWriteBack ? "Saving…" : "Save Write-Back Settings")
                                </FluentButton>
                            </div>
                            @if (_writeBackMessage is not null)
                            {
                                <FluentMessageBar Intent="@_writeBackMessageIntent" Class="card-message">
                                    @_writeBackMessage
                                </FluentMessageBar>
                            }
                        </FluentStack>
                    }
                </section>
            </div>
        </details>

    </FluentStack>
}
