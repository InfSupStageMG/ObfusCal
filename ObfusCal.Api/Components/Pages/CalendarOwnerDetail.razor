@page "/calendar-owners/{Id:guid}"
@attribute [Authorize]

<PageTitle>Calendar Owner - ObfusCal</PageTitle>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
    <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => Navigation.NavigateTo(BackLink))">
        ← Back
    </FluentButton>
    <h1>@(_owner?.Name ?? "Calendar Owner")</h1>
</FluentStack>

@if (_accessDeniedMessage is not null)
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="Access denied">
        @_accessDeniedMessage
    </FluentMessageBar>
}
else if (_owner is null)
{
    <FluentProgress/>
}
else
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="24">

        <section class="card">
            <h3>Availability Sync</h3>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                         VerticalAlignment="VerticalAlignment.Center">
                <FluentButton Appearance="Appearance.Outline" OnClick="TriggerOwnerSyncAsync"
                              Disabled="_triggeringSyncForOwner">
                    @(_triggeringSyncForOwner ? "Syncing…" : "Trigger Sync Now")
                </FluentButton>
            </FluentStack>
            @if (_triggeringSyncForOwner)
            {
                <div class="sync-progress-container">
                    <FluentProgress/>
                    @if (_ownerSyncProgress is not null)
                    {
                        <p class="sync-progress-label">@_ownerSyncProgress.Message</p>
                    }
                </div>
            }
            @if (_ownerSyncMessage is not null)
            {
                <FluentMessageBar Intent="@_ownerSyncMessageIntent" Class="card-message">
                    @_ownerSyncMessage
                </FluentMessageBar>
            }

            @if (_owner.HasGraphConsent || _hasWriteBackCapableSource)
            {
                <hr class="section-divider"/>
                <h4>Calendar Write-Back</h4>
                <p class="hint-text">
                    When enabled, active shadow slots and obfuscated busy time from your peers are written back into your linked calendar
                    sources as placeholder events.
                    Only start and end time are written - no peer identity, attendee data, or event details are ever included.
                </p>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                    <FluentSwitch @bind-Value="_writeBackEnabled" Label="Enable write-back to calendar"/>
                    @if (_writeBackEnabled)
                    {
                        <FluentTextField @bind-Value="_writeBackPlaceholderTitle"
                                         Label="Placeholder event title"
                                         Placeholder="Busy"
                                         style="max-width:320px"/>
                    }
                    <div>
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="SaveWriteBackSettingsAsync"
                                      Disabled="_savingWriteBack">
                            @(_savingWriteBack ? "Saving…" : "Save Write-Back Settings")
                        </FluentButton>
                    </div>
                    @if (_writeBackMessage is not null)
                    {
                        <FluentMessageBar Intent="@_writeBackMessageIntent" Class="card-message">
                            @_writeBackMessage
                        </FluentMessageBar>
                    }
                </FluentStack>
            }
        </section>

        <section class="card">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" Class="section-header-box">
                <h3 class="header-title-flex">Calendar Sources</h3>
                @if (_pluginOptions.Count > 0)
                {
                    <FluentButton Appearance="@(_showAddForm ? Appearance.Outline : Appearance.Accent)"
                                  OnClick="@(() => { _showAddForm = !_showAddForm; _sourceMessage = null; })">
                        @(_showAddForm ? "Cancel" : "+ Add Source")
                    </FluentButton>
                }
            </FluentStack>

            @if (_pluginOptions.Count == 0)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" Class="card-message">
                    No calendar source plugins were discovered. Drop plugin assemblies in the <code>plugins</code> folder and restart.
                </FluentMessageBar>
            }

            @if (_showAddForm)
            {
                <SourceAddForm PluginOptions="_pluginOptions"
                              @bind-SelectedOption="SelectedPluginOption"
                              @bind-DisplayName="_newSourceDisplayName"
                              @bind-ConfigurationFields="_newSourceConfigurationFields"
                              @bind-ConfigurationJson="_newSourceConfigurationJson"
                              @bind-SecretFields="_newSourceSecretFields"
                              @bind-SecretJson="_newSourceSecretDataJson"
                              @bind-IsEnabled="_newSourceIsEnabled"
                              IsLoading="_creatingSourceInstance"
                              Message="@(_sourceMessage is not null && _lastActionInstanceId is null ? _sourceMessage : null)"
                              MessageIntent="_sourceMessageIntent"
                              OnAddAsync="CreateSourceInstanceAsync"/>
            }

            @* Success message after add (form is now closed) *@
            @if (_sourceMessage is not null && _lastActionInstanceId is null && !_showAddForm)
            {
                <FluentMessageBar Intent="@_sourceMessageIntent" Class="card-message">@_sourceMessage</FluentMessageBar>
            }

            @if (_sourceInstances.Count > 0)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Class="source-section-margin">
                    @foreach (var instance in _sourceInstances)
                    {
                        <SourceInstanceEditor Instance="instance"
                                             IsSaving="_updatingSourceInstanceId == instance.Id"
                                             IsDeleting="_deletingSourceInstanceId == instance.Id"
                                             IsExecutingAction="_executingActionInstanceId == instance.Id"
                                             ExecutingActionId="_executingActionId"
                                             Message="@(_sourceMessage is not null && _lastActionInstanceId == instance.Id ? _sourceMessage : null)"
                                             MessageIntent="_sourceMessageIntent"
                                             OnSaveAsync="@(() => UpdateSourceInstanceAsync(instance))"
                                             OnDeleteAsync="@(() => DeleteSourceInstanceAsync(instance.Id))"
                                             OnActionAsync="@(action => InvokePluginActionAsync(instance, action))"/>
                    }
                </FluentStack>
            }
            else if (!_showAddForm)
            {
                <p>No calendar sources configured yet. Click <strong>+ Add Source</strong> to get started.</p>
            }
        </section>

        <div class="profiles-section">
            <h3>Obfuscation Profiles</h3>
            <div class="profiles-list">
                @foreach (var profile in _profiles)
                {
                    <ProfileCard @key="profile.Context" Profile="profile" OnSaveAsync="@(() => SaveProfileAsync(profile))"/>
                }
            </div>
            @if (_profileMessage is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Success" Class="card-message profiles-message">
                    @_profileMessage
                </FluentMessageBar>
            }
        </div>
    </FluentStack>
}
