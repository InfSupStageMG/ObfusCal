# Peer demo env file — used with docker-compose.peer-demo.yaml
#
# Copy this file to .env.peer-demo and fill in the values.
# The Entra/Graph/Google credentials are shared across both instances.
# Each instance has its own database and encryption key.
#
# Generate each COLUMNENCRYPTION__KEY with:
#   openssl rand -base64 32    (bash)
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))  (PowerShell 7)

# ── Shared: Entra ID ────────────────────────────────────────────────────────
# Both instances use the same app registration.
# Register both redirect URIs in Entra:
#   https://localhost/signin-oidc
#   https://localhost:4443/signin-oidc
AZUREAD__TENANTID=[AZURE_AD_TENANT_ID]
AZUREAD__CLIENTID=[AZURE_AD_CLIENT_ID]
AZUREAD__CLIENTSECRET=[AZURE_AD_CLIENT_SECRET]
GRAPHCONSENT__CLIENTID=[GRAPH_CLIENT_ID]
GRAPHCONSENT__CLIENTSECRET=[GRAPH_CLIENT_SECRET]

# ── Shared: Google Calendar ─────────────────────────────────────────────────
GOOGLECONSENT__CLIENTID=[GOOGLE_CLIENT_ID]
GOOGLECONSENT__CLIENTSECRET=[GOOGLE_CLIENT_SECRET]
GOOGLECONSENT__REDIRECTURI=[GOOGLE_REDIRECT_URI]

# ── Shared: API TLS certificate ─────────────────────────────────────────────
# Both instances mount ./certs/api/api.pfx — same cert is fine for a demo.
API_CERT_PASSWORD=[API_CERT_PASSWORD_HERE]

# ── Shared: container resource limits ───────────────────────────────────────
API_MEM_LIMIT=512m
API_CPUS=2.0

# ── Instance A ──────────────────────────────────────────────────────────────
POSTGRES_USER_A=postgres_a
POSTGRES_PASSWORD_A=[DB_PASSWORD_A]
POSTGRES_DB_A=obfuscal_a
COLUMNENCRYPTION__KEY_A=[COLUMN_ENCRYPTION_KEY_A]

# The outbound credential A presents to every peer it calls.
# After both stacks are up, enter this value as the API key when you
# add instance A as a peer connection on instance B's sysadmin page.
# Generate with: openssl rand -base64 32
SYNC__APIKEY_A=[SYNC_API_KEY_A]

# ── Instance B ──────────────────────────────────────────────────────────────
POSTGRES_USER_B=postgres_b
POSTGRES_PASSWORD_B=[DB_PASSWORD_B]
POSTGRES_DB_B=obfuscal_b
COLUMNENCRYPTION__KEY_B=[COLUMN_ENCRYPTION_KEY_B]

# Same concept: the outbound credential B presents to every peer it calls.
# Enter this value when you add instance B as a peer connection on instance A's
# sysadmin page.
# Generate with: openssl rand -base64 32
SYNC__APIKEY_B=[SYNC_API_KEY_B]
